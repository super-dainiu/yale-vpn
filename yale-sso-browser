#!/usr/bin/python3
"""Finish Yale's Microsoft/Duo browser login for OpenConnect."""

from __future__ import annotations

import os
import shutil
import sys
import tempfile
import time
from urllib.parse import urlsplit, urlunsplit

from selenium import webdriver
from selenium.common.exceptions import (
    NoSuchElementException,
    StaleElementReferenceException,
    WebDriverException,
)
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.remote.webelement import WebElement
from selenium.webdriver.support.ui import WebDriverWait

USER = os.environ.pop("YALE_SSO_USER", "")
PASSWORD = os.environ.pop("YALE_SSO_PASSWORD", "")
TIMEOUT = int(os.environ.get("YALE_SSO_TIMEOUT", "360"))


def log(message: str) -> None:
    print(f"[yale-sso] {message}", file=sys.stderr, flush=True)


def visible(elements: list[WebElement]) -> list[WebElement]:
    result = []
    for element in elements:
        try:
            if element.is_displayed() and element.is_enabled():
                result.append(element)
        except StaleElementReferenceException:
            pass
    return result


def first(driver: webdriver.Chrome, *selectors: str) -> WebElement | None:
    for selector in selectors:
        elements = visible(driver.find_elements(By.CSS_SELECTOR, selector))
        if elements:
            return elements[0]
    return None


def wait_for(driver: webdriver.Chrome, *selectors: str) -> WebElement:
    return WebDriverWait(
        driver,
        40,
        ignored_exceptions=(NoSuchElementException, StaleElementReferenceException),
    ).until(lambda current: first(current, *selectors))


def submit(driver: webdriver.Chrome, field: WebElement) -> None:
    button = first(driver, "input[type=submit]", "button[type=submit]", "button")
    try:
        if button is not None:
            button.click()
        else:
            field.send_keys(Keys.ENTER)
    except WebDriverException:
        field.send_keys(Keys.ENTER)


def page_text(driver: webdriver.Chrome) -> str:
    try:
        return driver.find_element(By.TAG_NAME, "body").text.casefold()
    except (NoSuchElementException, StaleElementReferenceException):
        return ""


def enter_duo_frame(driver: webdriver.Chrome) -> None:
    driver.switch_to.default_content()
    for frame in driver.find_elements(By.TAG_NAME, "iframe"):
        try:
            driver.switch_to.frame(frame)
            if visible(driver.find_elements(By.CSS_SELECTOR, "button, input")):
                return
            driver.switch_to.default_content()
        except (StaleElementReferenceException, WebDriverException):
            driver.switch_to.default_content()


def click_text(driver: webdriver.Chrome, *needles: str) -> bool:
    elements = visible(
        driver.find_elements(
            By.CSS_SELECTOR,
            "button, a, input[type=submit], [role=button], label",
        )
    )
    for element in elements:
        try:
            text = (
                element.text
                or element.get_attribute("value")
                or element.get_attribute("aria-label")
                or ""
            ).strip()
            if any(needle in text.casefold() for needle in needles):
                element.click()
                return True
        except (StaleElementReferenceException, WebDriverException):
            pass
    return False


def authenticate(driver: webdriver.Chrome) -> None:
    username = first(
        driver,
        "input[type=email]",
        "input[autocomplete=username]",
        "input[name=loginfmt]",
    )
    password = first(
        driver,
        "input[type=password]",
        "input[autocomplete=current-password]",
    )

    if username is not None and password is None:
        log("Submitting Yale email")
        username.send_keys(USER)
        submit(driver, username)
        password = wait_for(
            driver,
            "input[type=password]",
            "input[autocomplete=current-password]",
        )

    password = password or wait_for(
        driver,
        "input[type=password]",
        "input[autocomplete=current-password]",
    )
    log("Submitting NetID password")
    password.send_keys(PASSWORD)
    submit(driver, password)

    deadline = time.monotonic() + TIMEOUT
    last_click: dict[str, float] = {}
    push_logged = False

    def click_every(name: str, seconds: int, *needles: str) -> bool:
        now = time.monotonic()
        if now - last_click.get(name, 0) < seconds:
            return False
        if click_text(driver, *needles):
            last_click[name] = now
            return True
        return False

    while time.monotonic() < deadline:
        if driver.current_url.startswith("http://localhost:29786/"):
            log("Authentication complete")
            return

        driver.switch_to.default_content()
        text = page_text(driver)
        if "validation failure" in text:
            raise RuntimeError("Yale rejected or expired the SAML response")

        stay_signed_in = first(driver, "#idBtn_Back")
        if "stay signed in" in text and stay_signed_in is not None:
            stay_signed_in.click()
            time.sleep(2)
            continue

        enter_duo_frame(driver)
        if click_every(
            "duo",
            8,
            "approve with duo",
            "duo security",
            "duo push",
            "send me a push",
            "send a push",
            "verify with duo",
            "continue",
        ):
            log("Duo is ready; approve the push if prompted")

        if click_every(
            "shared-device",
            8,
            "no, other people use this device",
            "this is a shared device",
        ):
            log("Duo approved")

        if not push_logged and (
            "check for a duo push" in page_text(driver)
            or "sent a push" in page_text(driver)
        ):
            log("Duo push sent")
            push_logged = True

        driver.switch_to.default_content()
        time.sleep(1)

    raise TimeoutError("timed out waiting for Yale/Duo")


def main() -> int:
    if len(sys.argv) != 2:
        log("usage: yale-sso-browser SAML_URL")
        return 2

    runtime = "/run/yale-vpn"
    os.makedirs(runtime, mode=0o700, exist_ok=True)
    profile = tempfile.mkdtemp(prefix="chrome-", dir=runtime)

    options = Options()
    options.binary_location = "/usr/bin/google-chrome-stable"
    options.page_load_strategy = "eager"
    for argument in (
        "--headless=new",
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--disable-gpu",
        "--disable-extensions",
        "--incognito",
        "--no-first-run",
        "--password-store=basic",
        f"--user-data-dir={profile}",
    ):
        options.add_argument(argument)

    driver: webdriver.Chrome | None = None
    try:
        driver_path = "/snap/chromium/current/usr/lib/chromium-browser/chromedriver"
        driver = webdriver.Chrome(
            service=Service(driver_path),
            options=options,
        )
        driver.set_page_load_timeout(30)
        driver.get(sys.argv[1])

        if not USER or not PASSWORD:
            log("browser probe succeeded")
            return 3

        authenticate(driver)
        return 0
    except Exception as error:
        log(f"{type(error).__name__}: {error}")
        if driver is not None:
            url = urlsplit(driver.current_url)
            safe_url = urlunsplit((url.scheme, url.netloc, url.path, "", ""))
            log(f"Stopped at {safe_url}")
        return 1
    finally:
        if driver is not None:
            try:
                driver.quit()
            except WebDriverException:
                pass
        shutil.rmtree(profile, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
