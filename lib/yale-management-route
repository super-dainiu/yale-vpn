#!/usr/bin/env bash
set -Eeuo pipefail

readonly TABLE=200
readonly SSH_MARK=0x66

read -r _ _ GATEWAY _ IFACE _ < <(
  ip -4 route show table main default |
    awk '$5 !~ /^(tun|tap|vpn|yalevpn)/ {print; exit}'
)

if [[ -z ${GATEWAY:-} || -z ${IFACE:-} ]]; then
  echo "Could not determine the pre-VPN gateway and interface." >&2
  exit 1
fi

PRIVATE_IP=$(
  ip -o -4 addr show dev "$IFACE" scope global |
    awk '{sub(/\/.*/, "", $4); print $4; exit}'
)
if [[ -z $PRIVATE_IP ]]; then
  echo "Could not determine the private IPv4 address on $IFACE." >&2
  exit 1
fi

install -d -m 0755 /run/yale-vpn
printf 'IFACE=%q\nGATEWAY=%q\nPRIVATE_IP=%q\n' \
  "$IFACE" "$GATEWAY" "$PRIVATE_IP" >/run/yale-vpn/management.env

ip route replace table "$TABLE" default via "$GATEWAY" dev "$IFACE"
while ip rule del priority 90 2>/dev/null; do :; done
while ip rule del priority 100 2>/dev/null; do :; done
ip rule add priority 90 fwmark "$SSH_MARK"/0xffffffff lookup "$TABLE"
ip rule add priority 100 from "$PRIVATE_IP"/32 lookup "$TABLE"

nft delete table inet yale_management 2>/dev/null || true
nft -f - <<RULES
table inet yale_management {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    iifname "$IFACE" tcp dport 22 ct mark set $SSH_MARK
  }
  chain output {
    type route hook output priority mangle; policy accept;
    ct mark $SSH_MARK meta mark set ct mark
  }
}
RULES

sysctl -q -w net.ipv4.conf.all.rp_filter=2
sysctl -q -w "net.ipv4.conf.${IFACE}.rp_filter=2"

if [[ -n ${SSH_CONNECTION:-} ]]; then
  CLIENT_IP=${SSH_CONNECTION%% *}
  [[ $CLIENT_IP == *.* ]] &&
    ip route replace "$CLIENT_IP"/32 via "$GATEWAY" dev "$IFACE"
fi

echo "Management route: $PRIVATE_IP -> table $TABLE -> $GATEWAY dev $IFACE"
