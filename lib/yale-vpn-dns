#!/usr/bin/env bash
set -Eeuo pipefail

readonly VPN_INTERFACE=yalevpn
readonly YALE_DNS=(172.18.190.12 172.18.190.20 172.18.190.28)

for _ in {1..20}; do
  ip link show "$VPN_INTERFACE" >/dev/null 2>&1 && break
  sleep 0.25
done
ip link show "$VPN_INTERFACE" >/dev/null

resolvectl dns "$VPN_INTERFACE" "${YALE_DNS[@]}"
resolvectl domain "$VPN_INTERFACE" '~ycrc.yale.edu'
resolvectl default-route "$VPN_INTERFACE" no
resolvectl flush-caches

echo "YCRC DNS ready on $VPN_INTERFACE."
